# Copy to .env and fill in your keys. Do not commit .env.
# API_PROVIDER=openrouter  # or openai
# LLM_MODEL=openai/gpt-4o-mini  # OpenRouter: use provider/model (e.g. openai/gpt-4o-mini). OpenAI: use short name (e.g. gpt-4o-mini)
# EMBEDDING_MODEL=openai/text-embedding-3-small  # OpenRouter: provider/model. OpenAI: text-embedding-3-small
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# (Legacy: OPENROUTER_MODEL, OPENAI_MODEL, OPENAI_EMBEDDING_MODEL are overridden by LLM_MODEL / EMBEDDING_MODEL when set)
# APIFY_TOKEN=apify_api_...  # Required for property search (Realtor.ca via Apify)
# APIFY_ACTOR_ID=igolaizola/realtor-canada-scraper-ppe  # Optional; default as shown
# APIFY_MAX_ITEMS=100  # Optional; max listings per search (default 100)
# APIFY_MAX_CONCURRENT=5  # Optional; max concurrent multi-city Apify actor runs (default 5)
# APIFY_FETCH_DETAILS=true  # Optional; fetch listing descriptions (PublicRemarks). Extra Apify PPE cost; default true.
# SEARCH_MARKET=ca  # Optional; only "ca" is implemented (US later)
# TIMEZONE=America/Vancouver
# GOOGLE_MAPS_API_KEY=...  # Required for geocoding and proximity (Geocoding, Directions, Places APIs)

# Auth / guest mode (Streamlit UI)
# PREFS_DB_PATH=  # Optional; default ~/.rental_search_agent/preferences.db (signed-in users)
# AUTH_ALLOWLIST_ENABLED=false  # When true, only AUTH_ALLOWLIST emails/domains get full accounts
# AUTH_ALLOWLIST=  # Comma-separated emails and/or @domains (e.g. you@x.com,@yourco.com)
# ALLOW_DEV_PRINCIPAL=true  # When false and OIDC secrets missing, treat visitors as capped guests (use false on shared hosts)
# ANON_MAX_SEARCHES=3  # Guest Apify scrapes per browser session
# ANON_MAX_PROXIMITY_RULES=1  # Max parsed proximity rules for guests

# Multi-metric match scoring weights (optional; non-negative; renormalized over present components)
# Coverage is checklist-only (not part of overall match_score).
# SCORE_WEIGHT_STRUCTURAL=0.35
# SCORE_WEIGHT_PROXIMITY=0.25
# SCORE_WEIGHT_AMENITY=0.20
# SCORE_WEIGHT_SEMANTIC=0.20
# SCORE_PARALLEL_WORKERS=4
# SCORE_PARALLEL_MIN_LISTINGS=8

# Logging (optional)
# DEBUG, INFO, WARNING, ERROR, CRITICAL (default INFO)
# LOG_LEVEL=INFO
# Optional; relative paths resolve from project root. Console logging is always on; set this for a file (useful when Streamlit captures stderr).
# LOG_FILE=rental_search_agent_debug.log
