# Copy to .env and fill in your keys. Do not commit .env.
# API_PROVIDER=openrouter  # or openai
# LLM_MODEL=openai/gpt-4o-mini  # OpenRouter: use provider/model (e.g. openai/gpt-4o-mini). OpenAI: use short name (e.g. gpt-4o-mini)
# EMBEDDING_MODEL=openai/text-embedding-3-small  # OpenRouter: provider/model. OpenAI: text-embedding-3-small
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# (Legacy: OPENROUTER_MODEL, OPENAI_MODEL, OPENAI_EMBEDDING_MODEL are overridden by LLM_MODEL / EMBEDDING_MODEL when set)
# APIFY_TOKEN=apify_api_...  # Required for property search (Realtor.ca via Apify)
# APIFY_ACTOR_ID=igolaizola/realtor-canada-scraper-ppe  # Optional; default as shown
# APIFY_MAX_ITEMS=100  # Optional; max listings per search (default 100)
# SEARCH_MARKET=ca  # Optional; only "ca" is implemented (US later)
# TIMEZONE=America/Vancouver
# GOOGLE_MAPS_API_KEY=...  # Required for geocoding and proximity (Geocoding, Directions, Places APIs)
